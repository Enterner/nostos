{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "库：Debug",
      "description": "独立配置内核：只构建 nostos/ 本体（被 add_subdirectory 时不涉及）",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "库：RelWithDebInfo",
      "description": "独立配置内核：只构建 nostos/ 本体（被 add_subdirectory 时不涉及）",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "asan",
      "displayName": "库：RelWithDebInfo + AddressSanitizer",
      "description": "独立配置内核：ASan 只构建 nostos/ 本体（被 add_subdirectory 时不涉及）",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "NOSTOS_ASAN": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug", "configuration": "Debug" },
    { "name": "release", "configurePreset": "release", "configuration": "RelWithDebInfo" },
    { "name": "asan", "configurePreset": "asan", "configuration": "RelWithDebInfo" }
  ]
}
